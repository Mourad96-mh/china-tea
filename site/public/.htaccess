# China Tea Group — Apache / cPanel configuration for the static export.

Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the www host (update if the final domain has no www).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # The 711 brand was renamed 777 (the name printed on the box).
  RewriteRule ^(fr|en|es)/brands/711/?$ /$1/brands/777/ [L,R=301]

  # The tea-culture page was removed.
  RewriteRule ^(fr|en|es)/tea-ritual/?$ /$1/ [L,R=301]

  # The grocery page moved from /pantry/ to /conserves/.
  RewriteRule ^(fr|en|es)/pantry/?$ /$1/conserves/ [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType text/plain .txt
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
